# Copy to .streamlit/secrets.toml for local runs, and paste the same contents
# into Streamlit Community Cloud under: app menu -> Settings -> Secrets.
#
# Keep every key at ROOT level. Streamlit exposes root-level secrets as OS
# environment variables, which is how this app reads them -- wiser/database.py
# and openai_summarizer.py both go through os.environ, not st.secrets. Nesting
# a key under a [section] header makes it visible ONLY via st.secrets, so the
# app would silently fall back to the local Docker DSN and fail to connect.

# The RESTRICTED role, never the database owner. The owner can drop tables;
# this role deliberately cannot -- see sql/deploy_runtime_role.sql.
DATABASE_URL = "postgresql://wiser_app:REPLACE_ME@REPLACE_HOST.neon.tech/neondb?sslmode=require"

OPENAI_API_KEY = "sk-REPLACE_ME"
WISER_OPENAI_MODEL = "gpt-4o-mini"
